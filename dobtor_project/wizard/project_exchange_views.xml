<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- ============================================================ -->
        <!-- Export Wizard -->
        <!-- ============================================================ -->

        <record id="view_project_exchange_form" model="ir.ui.view">
            <field name="name">project.exchange.form</field>
            <field name="model">project.exchange</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <field name="project_id"/>
                        <field name="name" invisible="not file_save"/>
                        <field name="file_save" filename="name"
                               invisible="not file_save"/>
                        <field name="errors" invisible="not errors"
                               readonly="1" widget="text"/>
                    </group>
                    <footer>
                        <button name="action_export" string="Export"
                                type="object" class="btn-primary"
                                invisible="file_save"/>
                        <button string="Close" class="btn-secondary"
                                special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_project_exchange" model="ir.actions.act_window">
            <field name="name">Export Project (XML)</field>
            <field name="res_model">project.exchange</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <!-- ============================================================ -->
        <!-- Import Wizard -->
        <!-- ============================================================ -->

        <record id="view_project_exchange_import_form" model="ir.ui.view">
            <field name="name">project.exchange.import.form</field>
            <field name="model">project.exchange.import</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <field name="file_load" filename="name"/>
                        <field name="name" invisible="1"/>
                        <field name="project_id" invisible="not project_id"/>
                        <field name="errors" invisible="not errors"
                               readonly="1" widget="text"/>
                    </group>
                    <group string="Preview" invisible="not preview_line_ids">
                        <field name="preview_line_ids" nolabel="1">
                            <list>
                                <field name="section"/>
                                <field name="field_name"/>
                                <field name="xml_element"/>
                                <field name="xml_value"/>
                                <field name="converted_value"/>
                            </list>
                        </field>
                    </group>
                    <footer>
                        <button name="action_parse" string="Parse &amp; Preview"
                                type="object" class="btn-secondary"
                                invisible="preview_line_ids or project_id"/>
                        <button name="action_import" string="Import"
                                type="object" class="btn-primary"
                                invisible="not preview_line_ids or project_id"/>
                        <button string="Close" class="btn-secondary"
                                special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_project_exchange_import" model="ir.actions.act_window">
            <field name="name">Import Project (XML)</field>
            <field name="res_model">project.exchange.import</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <!-- ============================================================ -->
        <!-- Menu Items -->
        <!-- ============================================================ -->

        <menuitem id="menu_project_exchange"
                  name="Export/Import"
                  parent="project.menu_project_config"
                  sequence="90"/>

        <menuitem id="menu_project_exchange_export"
                  name="Export Project (XML)"
                  parent="menu_project_exchange"
                  action="action_project_exchange"
                  sequence="10"/>

        <menuitem id="menu_project_exchange_import"
                  name="Import Project (XML)"
                  parent="menu_project_exchange"
                  action="action_project_exchange_import"
                  sequence="20"/>

    </data>
</odoo>
