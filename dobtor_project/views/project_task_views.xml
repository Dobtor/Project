<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- ============================================================ -->
        <!-- Task Form View Extension - Integrated with Odoo 18 Structure -->
        <!-- ============================================================ -->
        <record id="ganttaps_view_task_form2" model="ir.ui.view">
            <field name="name">project.task.ganttaps.form</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="project.view_task_form2"/>
            <field name="priority">20</field>
            <field name="arch" type="xml">

                <!-- Add Gantt date fields to main form area (before notebook) -->
                <xpath expr="//field[@name='tag_ids']/parent::group" position="after">
                    <group name="gantt_dates" col="4" invisible="not project_id">
                        <field name="date_start" readonly="schedule_mode == 'auto'"/>
                        <field name="date_end" readonly="schedule_mode == 'auto'"/>
                        <field name="duration" widget="float_time" readonly="1"/>
                        <field name="progress" widget="progressbar"
                               readonly="progress_mode == 'timesheet'"/>
                        <field name="allocated_hours" widget="float_time"
                               invisible="progress_mode != 'timesheet'"/>
                        <field name="progress_mode" invisible="1"/>
                    </group>
                </xpath>

                <!-- Add Scheduling tab after sub_tasks_page -->
                <xpath expr="//page[@name='sub_tasks_page']" position="after">
                    <page name="gantt_scheduling" string="排程" invisible="not project_id">
                        <group>
                            <group string="排程設定">
                                <field name="schedule_mode" widget="radio"/>
                                <field name="fixed_calc_type" invisible="schedule_mode == 'manual'"/>
                                <field name="plan_duration"
                                       widget="float_time"
                                       invisible="schedule_mode == 'manual' or child_ids"/>
                                <field name="on_gantt"/>
                            </group>
                            <group string="約束條件">
                                <field name="constrain_type"/>
                                <field name="constrain_date" invisible="constrain_type in ('asap', 'alap')"/>
                            </group>
                        </group>
                        <group>
                            <group string="顯示">
                                <field name="color_gantt" widget="color_picker"/>
                                <field name="detail_plan"/>
                            </group>
                            <group string="工時">
                                <field name="detail_plan_work" widget="float_time" readonly="1"/>
                            </group>
                        </group>
                        <group string="成本與賺得值 (EVM)" groups="dobtor_project.group_project_cost_manager">
                            <group>
                                <field name="currency_id" invisible="1"/>
                                <field name="cost_hourly_rate" widget="monetary" readonly="1"/>
                                <field name="planned_cost" widget="monetary" readonly="1"/>
                                <field name="actual_cost" widget="monetary" readonly="1"/>
                                <field name="earned_value" widget="monetary" readonly="1"/>
                            </group>
                            <group>
                                <field name="planned_value" widget="monetary" readonly="1"/>
                                <field name="cost_variance" widget="monetary" readonly="1"
                                       decoration-danger="cost_variance &lt; 0"/>
                                <field name="schedule_variance" widget="monetary" readonly="1"
                                       decoration-danger="schedule_variance &lt; 0"/>
                                <!-- CPI/SPI are ratios: with no cost booked
                                     (AC=0) or nothing scheduled yet (PV=0) they
                                     are UNDEFINED, not zero. Showing 0.00 read
                                     as "performance is nil". -->
                                <label for="cpi"/>
                                <div>
                                    <field name="cpi" readonly="1" nolabel="1"
                                           invisible="actual_cost == 0"
                                           decoration-danger="cpi &lt; 1"
                                           decoration-success="cpi &gt;= 1"/>
                                    <span invisible="actual_cost != 0"
                                          title="尚無實際成本，無法計算">—</span>
                                </div>
                                <label for="spi"/>
                                <div>
                                    <field name="spi" readonly="1" nolabel="1"
                                           invisible="planned_value == 0"
                                           decoration-danger="spi &lt; 1"
                                           decoration-success="spi &gt;= 1"/>
                                    <span invisible="planned_value != 0"
                                          title="尚未進入排定期間，無法計算">—</span>
                                </div>
                            </group>
                        </group>
                        <!-- Hidden fields -->
                        <field name="duration_scale" invisible="1"/>
                        <field name="duration_work_scale" invisible="1"/>
                        <field name="duration_picker" invisible="1"/>
                        <field name="summary_date_start" invisible="1"/>
                        <field name="summary_date_end" invisible="1"/>
                    </page>
                </xpath>

                <!-- Hide native "Blocked By" tab — replaced by unified predecessors -->
                <xpath expr="//page[@name='task_dependencies']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

                <!-- Add unified Predecessors tab (scheduling + blocking) -->
                <xpath expr="//page[@name='task_dependencies']" position="after">
                    <page name="gantt_predecessors" string="前置任務" invisible="not project_id">
                        <div class="text-muted mb-2">
                            定義排程依賴關係與阻擋狀態（勾選「阻擋」= 前置未完成時本任務自動等待）
                        </div>
                        <field name="predecessor_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="parent_task_id" string="前置任務"/>
                                <field name="type" string="關聯類型"/>
                                <field name="lag_hours" string="延遲(小時)" widget="float_time"/>
                                <field name="enable_blocking" string="阻擋"/>
                            </list>
                        </field>
                    </page>
                </xpath>

                <!-- Add Resources tab after Predecessors -->
                <xpath expr="//page[@name='gantt_predecessors']" position="after">
                    <page name="gantt_resources" string="資源" invisible="not project_id">
                        <field name="task_resource_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="resource_id"/>
                                <field name="load_factor" string="負載 %"/>
                                <field name="resource_type"/>
                                <field name="load_control"/>
                            </list>
                        </field>
                    </page>
                </xpath>

                <!-- Add Gantt Info to Extra Info tab -->
                <xpath expr="//page[@name='extra_info']/group" position="inside">
                    <group string="甘特圖資訊">
                        <field name="critical_path" readonly="1"/>
                        <field name="p_loop" readonly="1"/>
                        <field name="sorting_seq"/>
                        <field name="sorting_level"/>
                        <field name="fold"/>
                    </group>
                </xpath>

                <!-- Add info_ids to Extra Info tab -->
                <xpath expr="//page[@name='extra_info']" position="inside">
                    <group string="甘特圖顯示資訊">
                        <field name="info_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="name"/>
                                <field name="start"/>
                                <field name="end"/>
                                <field name="left_up"/>
                                <field name="left_down"/>
                                <field name="right_up"/>
                                <field name="right_down"/>
                                <field name="show"/>
                            </list>
                        </field>
                    </group>
                </xpath>

            </field>
        </record>

        <!-- ============================================================ -->
        <!-- Task List View Extension -->
        <!-- ============================================================ -->
        <record id="view_task_list2_gantt" model="ir.ui.view">
            <field name="name">project.task.list.gantt</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="project.view_task_tree2"/>
            <field name="priority">20</field>
            <field name="arch" type="xml">
                <xpath expr="//list" position="inside">
                    <field name="date_start" optional="hide"/>
                    <field name="duration" widget="float_time" optional="hide"/>
                    <field name="schedule_mode" optional="hide"/>
                </xpath>
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- Gantt APS View Definition -->
        <!-- ============================================================ -->
        <record id="view_task_ganttaps" model="ir.ui.view">
            <field name="name">project.task.ganttaps</field>
            <field name="model">project.task</field>
            <field name="type">ganttaps</field>
            <field name="priority">20</field>
            <field name="arch" type="xml">
                <ganttaps
                    progress="progress"
                    default_group_by="project_id"
                    action_menu="project_id"
                    main_group_id_name="project_id"
                    main_group_model="project.project"
                    name="name"
                    date_start="date_start"
                    date_stop="date_end"
                    user_id="user_ids"
                    project_id="project_id"
                    date_deadline="date_deadline"
                    on_gantt="on_gantt"
                    date_done="date_finished"
                    predecessor_model="project.task.predecessor"
                    predecessor_task_id="task_id"
                    predecessor_parent_task_id="parent_task_id"
                    predecessor_type="type"
                    subtask_project_id="project_id"
                    parent_id="parent_id"
                    subtask_count="subtask_count"
                    schedule_mode="schedule_mode"
                    constrain_type="constrain_type"
                    constrain_date="constrain_date"
                    duration="duration"
                    plan_duration="plan_duration"
                    summary_date_start="summary_date_start"
                    summary_date_end="summary_date_end"
                    plan_action="plan_action"
                    color_gantt="color_gantt"
                    duration_scale="duration_scale"
                    sorting_seq="sorting_seq"
                    sorting_level="sorting_level"
                    default_seq="sequence"
                    fold="fold"
                    limit_view="250"
                    info_model="project.task.info"
                    info_ids="info_ids"
                    critical_path="critical_path"
                    cp_shows="cp_shows"
                    cp_detail="cp_detail"
                    p_loop="p_loop"
                    load_bar_model="project.task.detail.plan"
                    load_id="task_id"
                    load_id_from="task_id"
                    load_ids_from="id"
                    default_order="date_start asc"
                    doc_count="attachment_ids"
                    ghost_model="account.analytic.line"
                    ghost_task_id="task_id"
                    ghost_name="name"
                    ghost_date_start="date"
                    ghost_durations="unit_amount"
                    plan_offset="plan_offset"
                    milestone_id="milestone_id"
                    progress_mode="progress_mode"
                    fixed_calc_type="fixed_calc_type"
                >
                </ganttaps>
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- Action Configuration -->
        <!-- ============================================================ -->

        <!-- Add ganttaps to task actions — ganttaps as default view -->
        <record id="project.act_project_project_2_project_task_all" model="ir.actions.act_window">
            <field name="view_mode">ganttaps,kanban,list,form,calendar,pivot,graph,activity</field>
        </record>

        <!-- ganttaps view first (sequence 1, before kanban=10) -->
        <record id="project_task_ganttaps_action_view" model="ir.actions.act_window.view">
            <field name="sequence" eval="1"/>
            <field name="view_mode">ganttaps</field>
            <field name="view_id" ref="view_task_ganttaps"/>
            <field name="act_window_id" ref="project.act_project_project_2_project_task_all"/>
        </record>

    </data>
</odoo>
