<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Project Form View Extension -->
        <record id="edit_project_ganttaps_inherited" model="ir.ui.view">
            <field name="name">project.project.ganttaps.edit.inherited</field>
            <field name="model">project.project</field>
            <field name="inherit_id" ref="project.edit_project"/>
            <field name="priority">24</field>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="甘特圖" name="gantt_settings">
                        <group>
                            <group string="自動排程任務">
                                <field name="scheduling_type"/>
                                <field name="schedule_start" invisible="scheduling_type == 'backward'"/>
                                <field name="schedule_end" invisible="scheduling_type == 'forward'"/>
                                <field name="use_calendar"/>
                                <field name="resource_calendar_id"
                                       invisible="not use_calendar"
                                       options="{'no_create': True}"/>
                                <field name="tz" widget="timezone_mismatch" options="{'tz_offset_field': 'tz_offset'}"/>
                                <field name="tz_offset" invisible="1"/>
                            </group>

                            <group string="進度追蹤">
                                <field name="progress_mode"/>
                            </group>

                            <group string="任務預設值">
                                <field name="task_default_duration" widget="float_time"/>
                                <field name="task_default_start" widget="float_time"/>
                                <field name="task_default_schedule_mode"/>
                                <field name="task_default_constrain_type"/>
                                <field name="task_default_fixed_calc_type"/>
                                <field name="task_default_color_gantt" widget="color_picker"/>
                                <button name="action_apply_color_to_tasks"
                                        string="套用至所有任務"
                                        type="object"
                                        class="btn-link"/>
                                <field name="task_default_on_gantt"/>
                                <field name="detail_plan"/>
                            </group>

                            <field name="task_default_start_end"/>

                            <group name="duration_scale" string="工期顯示格式">
                                <field name="duration_scale"/>
                                <field name="duration_picker"/>
                            </group>

                            <group name="critical_path" string="關鍵路徑">
                                <field name="cp_shows"/>
                                <field name="cp_detail"/>
                            </group>
                        </group>
                    </page>
                    <page string="成本與賺得值" name="evm_settings">
                        <group>
                            <group string="設定">
                                <field name="status_date"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                            <group string="成本">
                                <field name="total_planned_cost" widget="monetary"/>
                                <field name="total_actual_cost" widget="monetary"/>
                                <field name="total_cost_variance" widget="monetary"
                                       decoration-danger="total_cost_variance &lt; 0"/>
                            </group>
                            <group string="賺得值">
                                <field name="total_earned_value" widget="monetary"/>
                                <field name="total_planned_value" widget="monetary"/>
                                <field name="total_schedule_variance" widget="monetary"
                                       decoration-danger="total_schedule_variance &lt; 0"/>
                            </group>
                            <group string="績效指數">
                                <field name="project_cpi"
                                       decoration-danger="project_cpi &lt; 1 and project_cpi &gt; 0"
                                       decoration-success="project_cpi &gt;= 1"/>
                                <field name="project_spi"
                                       decoration-danger="project_spi &lt; 1 and project_spi &gt; 0"
                                       decoration-success="project_spi &gt;= 1"/>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
