<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Task Resource Link List View (Odoo 18: tree renamed to list) -->
        <record id="view_project_task_resource_link_list" model="ir.ui.view">
            <field name="name">project.task.resource.link.list</field>
            <field name="model">project.task.resource.link</field>
            <field name="arch" type="xml">
                <list editable="bottom">
                    <field name="task_id"/>
                    <field name="resource_id"/>
                    <field name="load_factor"/>
                    <field name="resource_type"/>
                    <field name="load_control"/>
                    <field name="date_start"/>
                    <field name="date_end"/>
                    <field name="duration" widget="float_time"/>
                    <field name="project_id"/>
                </list>
            </field>
        </record>

        <!-- Task Resource Link Form View -->
        <record id="view_project_task_resource_link_form" model="ir.ui.view">
            <field name="name">project.task.resource.link.form</field>
            <field name="model">project.task.resource.link</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="task_id"/>
                                <field name="resource_id"/>
                                <field name="load_factor"/>
                            </group>
                            <group>
                                <field name="resource_type"/>
                                <field name="load_control"/>
                                <field name="project_id"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="date_start"/>
                                <field name="date_end"/>
                            </group>
                            <group>
                                <field name="duration" widget="float_time"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Task Detail Plan List View (Odoo 18: tree renamed to list) -->
        <record id="view_project_task_detail_plan_list" model="ir.ui.view">
            <field name="name">project.task.detail.plan.list</field>
            <field name="model">project.task.detail.plan</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="task_id"/>
                    <field name="type_level"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="duration" widget="float_time"/>
                    <field name="resource_id"/>
                    <field name="date_aggr"/>
                </list>
            </field>
        </record>

        <!-- Task Predecessor List View (Odoo 18: tree renamed to list) -->
        <record id="view_project_task_predecessor_list" model="ir.ui.view">
            <field name="name">project.task.predecessor.list</field>
            <field name="model">project.task.predecessor</field>
            <field name="arch" type="xml">
                <list editable="bottom">
                    <field name="task_id"/>
                    <field name="parent_task_id"/>
                    <field name="type"/>
                    <field name="lag_hours" string="延遲(小時)" widget="float_time"/>
                </list>
            </field>
        </record>

        <!-- Resource Link Gantt View -->
        <record id="view_project_task_resource_link_ganttaps" model="ir.ui.view">
            <field name="name">project.task.resource.link.ganttaps</field>
            <field name="model">project.task.resource.link</field>
            <field name="type">ganttaps</field>
            <field name="arch" type="xml">
                <ganttaps
                    default_group_by="resource_id"
                    main_group_id_name="resource_id"
                    name="name"
                    date_start="date_start"
                    date_stop="date_end"
                    duration="duration"
                    limit_view="500"
                >
                </ganttaps>
            </field>
        </record>

        <!-- Detail Plan Gantt View -->
        <record id="view_project_task_detail_plan_ganttaps" model="ir.ui.view">
            <field name="name">project.task.detail.plan.ganttaps</field>
            <field name="model">project.task.detail.plan</field>
            <field name="type">ganttaps</field>
            <field name="arch" type="xml">
                <ganttaps
                    default_group_by="task_id"
                    main_group_id_name="task_id"
                    name="name"
                    date_start="date_from"
                    date_stop="date_to"
                    duration="duration"
                    color_gantt="color_gantt"
                    schedule_mode="schedule_mode"
                    limit_view="1000"
                >
                </ganttaps>
            </field>
        </record>

        <!-- Task Info List View (Odoo 18: tree renamed to list) -->
        <record id="view_project_task_info_list" model="ir.ui.view">
            <field name="name">project.task.info.list</field>
            <field name="model">project.task.info</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="task_id"/>
                    <field name="start"/>
                    <field name="end"/>
                    <field name="left_up"/>
                    <field name="left_down"/>
                    <field name="right_up"/>
                    <field name="right_down"/>
                    <field name="show"/>
                </list>
            </field>
        </record>
    </data>
</odoo>
