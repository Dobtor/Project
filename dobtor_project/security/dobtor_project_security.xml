<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">
        <!-- Cost / Earned-Value visibility group. Cost rates and EVM figures
             are sensitive, so the related fields are restricted to this group.
             Project managers get it automatically; regular project users do
             not see cost data. -->
        <record id="group_project_cost_manager" model="res.groups">
            <field name="name">專案成本與賺得值 (EVM)</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="comment">可檢視專案成本、資源費率與賺得值(EVM)資訊。</field>
        </record>
        <record id="project.group_project_manager" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('dobtor_project.group_project_cost_manager'))]"/>
        </record>

        <!-- Multi-company Record Rules for Odoo 18 -->

        <!-- Project Task Predecessor: Multi-company rule -->
        <record id="project_task_predecessor_multi_company_rule" model="ir.rule">
            <field name="name">Project Task Predecessor: Multi-company</field>
            <field name="model_id" ref="model_project_task_predecessor"/>
            <field name="domain_force">[
                '|',
                ('task_id.company_id', '=', False),
                ('task_id.company_id', 'in', company_ids)
            ]</field>
        </record>

        <!-- Project Task Detail Plan: Multi-company rule -->
        <record id="project_task_detail_plan_multi_company_rule" model="ir.rule">
            <field name="name">Project Task Detail Plan: Multi-company</field>
            <field name="model_id" ref="model_project_task_detail_plan"/>
            <field name="domain_force">[
                '|',
                ('task_id.company_id', '=', False),
                ('task_id.company_id', 'in', company_ids)
            ]</field>
        </record>

        <!-- Project Task Info: Multi-company rule -->
        <record id="project_task_info_multi_company_rule" model="ir.rule">
            <field name="name">Project Task Info: Multi-company</field>
            <field name="model_id" ref="model_project_task_info"/>
            <field name="domain_force">[
                '|',
                ('task_id.company_id', '=', False),
                ('task_id.company_id', 'in', company_ids)
            ]</field>
        </record>

        <!-- Project Task Resource Link: Multi-company rule -->
        <record id="project_task_resource_link_multi_company_rule" model="ir.rule">
            <field name="name">Project Task Resource Link: Multi-company</field>
            <field name="model_id" ref="model_project_task_resource_link"/>
            <field name="domain_force">[
                '|',
                ('task_id.company_id', '=', False),
                ('task_id.company_id', 'in', company_ids)
            ]</field>
        </record>

        <!-- Project Baseline: Multi-company rule -->
        <record id="project_baseline_multi_company_rule" model="ir.rule">
            <field name="name">Project Baseline: Multi-company</field>
            <field name="model_id" ref="model_project_baseline"/>
            <field name="domain_force">[
                '|',
                ('project_id.company_id', '=', False),
                ('project_id.company_id', 'in', company_ids)
            ]</field>
        </record>

        <!-- Project Baseline Line: Multi-company rule -->
        <record id="project_baseline_line_multi_company_rule" model="ir.rule">
            <field name="name">Project Baseline Line: Multi-company</field>
            <field name="model_id" ref="model_project_baseline_line"/>
            <field name="domain_force">[
                '|',
                ('baseline_id.project_id.company_id', '=', False),
                ('baseline_id.project_id.company_id', 'in', company_ids)
            ]</field>
        </record>

    </data>
</odoo>
