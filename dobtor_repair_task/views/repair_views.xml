<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_repair_order_form_inherit_task" model="ir.ui.view">
            <field name="name">repair.form.inherit.task</field>
            <field name="model">repair.order</field>
            <field name="inherit_id" ref="repair.view_repair_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                    <button name="action_view_task_order" type="object" string="Task Order" icon="fa-dollar" class="oe_stat_button" invisible="not task_order_id">
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_value">
                                <field name="task_order_id" widget="statinfo" nolabel="1" class="mr4"/>
                            </span>
                            <span class="o_stat_text">Task Order</span>
                        </div>
                    </button>
                </xpath>
            </field>
        </record>
    </data>
</odoo>