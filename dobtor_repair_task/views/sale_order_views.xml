<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_order_form_inherit_distributor" model="ir.ui.view">
            <field name="name">sale.order.form.distributor</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='order_line']//tree" position="inside">
                    <field string="Distributor" name="distributor_ids" optional="hidden" widget="many2many_tags"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
