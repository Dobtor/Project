#. module: dobtor_repair_task
#: model_terms:ir.ui.view,arch_db:dobtor_repair_task.view_task_change_distributor_wizard_form model_terms:ir.ui.view,arch_db:dobtor_repair_task.view_task_self_install_wizard_form
msgid "Confirm"
msgstr "確認"

#. module: dobtor_repair_task
#: model:ir.model.fields,field_description:dobtor_repair_task.field_dobtor_task_change_distributor_wizard__current_distributor_ids
msgid "Current Installer"
msgstr "目前安裝經銷商"

#. module: dobtor_repair_task
#. odoo-python
#: code:addons/dobtor_repair_task/models/project_task.py:0 model:ir.model,name:dobtor_repair_task.model_dobtor_task_self_install_wizard model_terms:ir.ui.view,arch_db:dobtor_repair_task.view_task_form2_inherit_repair model_terms:ir.ui.view,arch_db:dobtor_repair_task.view_task_self_install_wizard_form
#, python-format
msgid "Customer Self-Installed"
msgstr "客戶自行安裝"

#. module: dobtor_repair_task
#. odoo-python
#: code:addons/dobtor_repair_task/models/project_task.py:0
#, python-format
msgid "Customer installed it by themselves. Task cancelled."
msgstr "客人自行安裝，派工單已取消。"

#. module: dobtor_repair_task
#: model:ir.model.fields,help:dobtor_repair_task.field_dobtor_task_change_distributor_wizard__update_customer
msgid "Future repairs and returns of this customer will also go to the new distributor."
msgstr "這位客人之後的報修、退貨也會找新的經銷商。"

#. module: dobtor_repair_task
#: model:ir.model.fields,field_description:dobtor_repair_task.field_dobtor_task_self_install_wizard__installation_fee
msgid "Installation Fee"
msgstr "安裝費"

#. module: dobtor_repair_task
#: model:ir.model.fields,field_description:dobtor_repair_task.field_dobtor_task_change_distributor_wizard__task_id model:ir.model.fields,field_description:dobtor_repair_task.field_dobtor_task_self_install_wizard__task_id
msgid "Installation Task"
msgstr "安裝派工單"

#. module: dobtor_repair_task
#. odoo-python
#: code:addons/dobtor_repair_task/models/project_task.py:0
#, python-format
msgid "Installer changed from %(old)s to %(new)s."
msgstr "安裝經銷商從 %(old)s 換成 %(new)s。"

#. module: dobtor_repair_task
#: model:ir.model.fields,field_description:dobtor_repair_task.field_dobtor_task_change_distributor_wizard__new_distributor_id
msgid "New Installer"
msgstr "新的安裝經銷商"

#. module: dobtor_repair_task
#: model:ir.model.fields,help:dobtor_repair_task.field_dobtor_task_self_install_wizard__installation_fee
msgid "Not refunded automatically. If the customer paid for installation, please create a credit note."
msgstr "不會自動退款。客人如果有付安裝費，請另外開折讓單。"

#. module: dobtor_repair_task
#. odoo-python
#: code:addons/dobtor_repair_task/models/project_task.py:0
#, python-format
msgid "Only installation tasks that are not done or cancelled can be changed."
msgstr "只有還沒完工、沒取消的安裝派工可以操作。"

#. module: dobtor_repair_task
#. odoo-python
#: code:addons/dobtor_repair_task/models/project_task.py:0
#, python-format
msgid "Please set the Cancel Stage in the settings first."
msgstr "請先到設定指定「取消階段」。"

#. module: dobtor_repair_task
#: model:ir.model.fields,field_description:dobtor_repair_task.field_dobtor_task_change_distributor_wizard__reason model:ir.model.fields,field_description:dobtor_repair_task.field_dobtor_task_self_install_wizard__reason
msgid "Reason"
msgstr "原因"

#. module: dobtor_repair_task
#. odoo-python
#: code:addons/dobtor_repair_task/models/project_task.py:0 code:addons/dobtor_repair_task/models/project_task.py:0
#, python-format
msgid "Reason: %(reason)s"
msgstr "原因：%(reason)s"

#. module: dobtor_repair_task
#: model_terms:ir.ui.view,arch_db:dobtor_repair_task.view_task_change_distributor_wizard_form
msgid "The task is assigned to the new installer. If it was already arranged or accepted, it goes back to the arranged stage so the new installer is notified by SMS. The commission moves to the new installer."
msgstr "派工單會改指派給新的經銷商。已經安排或承攬的會退回「已安排」，新經銷商會收到簡訊通知。佣金也會改給新經銷商。"

#. module: dobtor_repair_task
#: model_terms:ir.ui.view,arch_db:dobtor_repair_task.view_task_self_install_wizard_form
msgid "The task will be cancelled (cancellation SMS is sent as configured) and the installer will not get this commission."
msgstr "派工單會改成取消（照設定發取消簡訊），這筆安裝佣金不發給經銷商。"

#. module: dobtor_repair_task
#: model_terms:ir.ui.view,arch_db:dobtor_repair_task.view_task_self_install_wizard_form
msgid "This order has an installation fee. It is not refunded automatically; please create a credit note for the customer."
msgstr "這張訂單有收安裝費，系統不會自動退款，請另外替客人開折讓單。"

#. module: dobtor_repair_task
#: model_terms:ir.ui.view,arch_db:dobtor_repair_task.view_task_change_distributor_wizard_form
msgid "e.g. The customer asked for another installer"
msgstr "例如：客人想換一家經銷商"

#. module: dobtor_repair_task
#: model_terms:ir.ui.view,arch_db:dobtor_repair_task.view_task_self_install_wizard_form
msgid "e.g. The customer installed it before the installer arrived"
msgstr "例如：經銷商還沒到，客人自己先裝好了"
